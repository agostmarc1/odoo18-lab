<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="lab_default_task_list" model="ir.ui.view">
        <field name="name">lab.default.task.list</field>
        <field name="model">lab.default.task</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="share_pct" sum="Totale (lo Sviluppo prende il resto)"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="action_default_tasks" model="ir.actions.act_window">
        <field name="name">Task di default commessa</field>
        <field name="res_model">lab.default.task</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
