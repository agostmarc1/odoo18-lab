<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="lab_margin_report_pivot" model="ir.ui.view">
        <field name="name">lab.margin.report.pivot</field>
        <field name="model">lab.margin.report</field>
        <field name="arch" type="xml">
            <pivot string="Margini per commessa" disable_linking="0">
                <field name="partner_id" type="row"/>
                <field name="project_id" type="row"/>
                <field name="sold_amount" type="measure"/>
                <field name="passthrough_revenue" type="measure"/>
                <field name="timesheet_cost" type="measure"/>
                <field name="ai_cost" type="measure"/>
                <field name="external_cost" type="measure"/>
                <field name="other_vendor_cost" type="measure"/>
                <field name="margin" type="measure"/>
                <field name="margin_excl_passthrough" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="lab_margin_report_list" model="ir.ui.view">
        <field name="name">lab.margin.report.list</field>
        <field name="model">lab.margin.report</field>
        <field name="arch" type="xml">
            <list decoration-danger="margin &lt; 0">
                <field name="project_id"/>
                <field name="partner_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="sold_amount" sum="Totale"/>
                <field name="passthrough_revenue" sum="Totale" optional="show"/>
                <field name="invoiced_amount" sum="Totale" optional="hide"/>
                <field name="timesheet_cost" sum="Totale"/>
                <field name="ai_cost" sum="Totale"/>
                <field name="external_cost" sum="Totale"/>
                <field name="external_accrued" sum="Totale" optional="hide"/>
                <field name="other_vendor_cost" sum="Totale" optional="show"/>
                <field name="passthrough_cost" sum="Totale" optional="hide"/>
                <field name="total_cost" sum="Totale" optional="hide"/>
                <field name="margin" sum="Totale"/>
                <field name="margin_pct" widget="percentage_text" optional="show"/>
                <field name="margin_excl_passthrough" sum="Totale" optional="hide"/>
                <field name="hours_estimated" sum="Totale" widget="float_time" optional="hide"/>
                <field name="hours_consumed" sum="Totale" widget="float_time"/>
                <field name="hours_saved" sum="Totale" widget="float_time" optional="show"/>
            </list>
        </field>
    </record>
    <record id="lab_margin_report_search" model="ir.ui.view">
        <field name="name">lab.margin.report.search</field>
        <field name="model">lab.margin.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="project_id"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <filter name="sold" string="Commesse vendute" domain="[('sold_amount', '>', 0)]"/>
                <filter name="negative" string="Margine negativo" domain="[('margin', '&lt;', 0)]"/>
                <filter name="accrued" string="Fatture consulenti da ricevere"
                        domain="[('external_accrued', '>', 0)]"/>
            </search>
        </field>
    </record>
    <record id="action_margin_report" model="ir.actions.act_window">
        <field name="name">Margini per commessa</field>
        <field name="res_model">lab.margin.report</field>
        <field name="view_mode">list,pivot</field>
        <field name="context">{'search_default_sold': 1}</field>
        <field name="help" type="html">
            <p>Ricavi: venduto (T&amp;M = ore consegnate × prezzo) + ribaltato al cliente.
               Costi: lavoro interno (già diviso nei giorni in parallelo), AI (licenze e
               consumi ripartiti per mese), consulenti esterni (fattura, oppure ore × tariffa
               finché manca) e altri costi fornitori della commessa.</p>
        </field>
    </record>
</odoo>
