<?xml version="1.0" encoding="utf-8"?>
<!-- Ticketing: sul ticket si vedono tipo di contratto e consumo del monte ore della commessa. -->
<odoo>
    <record id="helpdesk_ticket_form_lab" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.lab</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_mgmt_timesheet.ticket_view_form_project_required"/>
        <field name="arch" type="xml">
            <!-- OCA rende obbligatoria la commessa quando il team segna le ore: un ticket di un
                 contatto nuovo o senza contratto deve poter restare senza commessa finché il
                 Supporto non la sceglie (le ore, invece, richiedono sempre la commessa). -->
            <xpath expr="//field[@name='project_id'][2]" position="attributes">
                <attribute name="required">False</attribute>
                <attribute name="string">Commessa</attribute>
            </xpath>
            <xpath expr="//field[@name='task_id'][2]" position="after">
                <field name="lab_contract_type" invisible="not project_id" groups="project.group_project_user"/>
                <label for="lab_consumption_pct" string="Monte ore"
                       invisible="not project_id" groups="project.group_project_user"/>
                <div class="o_row" invisible="not project_id" groups="project.group_project_user">
                    <field name="lab_consumption_pct" widget="progressbar" nolabel="1"/>
                    <field name="lab_hours_alert" widget="badge" nolabel="1"
                           decoration-success="lab_hours_alert == 'ok'"
                           decoration-warning="lab_hours_alert == 'warning'"
                           decoration-danger="lab_hours_alert == 'danger'"/>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Conferma via email dei ticket dal sito: avviso, pulsante per il Supporto, filtro -->
    <record id="helpdesk_ticket_form_lab_confirm" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.lab.confirm</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_mgmt.ticket_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='assign_to_me']" position="before">
                <button name="action_lab_web_confirm" type="object" string="Conferma richiesta"
                        class="btn-primary" invisible="lab_web_confirmed"
                        groups="helpdesk_mgmt.group_helpdesk_user"
                        confirm="Confermi a mano la richiesta? Fallo solo se hai verificato chi l'ha inviata (es. ti ha telefonato): il ticket verrà collegato all'azienda dell'email."/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <field name="lab_web_confirmed" invisible="1"/>
                <div class="alert alert-warning mb-0" role="alert" invisible="lab_web_confirmed">
                    <strong>Da confermare.</strong> Richiesta arrivata dal sito: il cliente non ha ancora
                    cliccato il link di conferma inviato per email.
                    Finché non conferma, il ticket non è collegato all'azienda e gli SLA non partono.
                </div>
            </xpath>
        </field>
    </record>

    <record id="helpdesk_ticket_search_lab_confirm" model="ir.ui.view">
        <field name="name">helpdesk.ticket.search.lab.confirm</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_mgmt.helpdesk_ticket_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='unassigned']" position="before">
                <filter string="Da confermare (sito)" name="lab_to_confirm"
                        domain="[('lab_web_confirmed', '=', False)]"/>
                <separator/>
            </xpath>
        </field>
    </record>
</odoo>
