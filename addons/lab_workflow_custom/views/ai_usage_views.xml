<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===== Consumi AI ===== -->
    <record id="view_ai_usage_list" model="ir.ui.view">
        <field name="name">lab.ai.usage.list</field>
        <field name="model">lab.ai.usage</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-warning="attribution == 'overhead'">
                <header>
                    <button name="action_import_anthropic" type="object" display="always"
                            string="Importa da Anthropic (ultimi 30 giorni)"
                            groups="lab_workflow_custom.group_lab_amministrazione,base.group_system"/>
                    <button name="action_rematch" type="object" string="Riapplica corrispondenze"/>
                </header>
                <field name="date"/>
                <field name="source" optional="show"/>
                <field name="tool_id" optional="hide"/>
                <field name="description" optional="show"/>
                <field name="workspace_ref" optional="show"/>
                <field name="api_key_ref" optional="hide"/>
                <field name="actor_ref" optional="show"/>
                <field name="amount_currency" sum="Totale"/>
                <field name="currency_id" groups="base.group_multi_currency"/>
                <field name="amount" sum="Totale" optional="show"/>
                <field name="company_currency_id" column_invisible="True"/>
                <field name="project_id"/>
                <field name="employee_id"/>
                <field name="attribution" widget="badge"
                       decoration-success="attribution == 'direct'"
                       decoration-info="attribution == 'person'"
                       decoration-warning="attribution == 'overhead'"/>
            </list>
        </field>
    </record>
    <record id="view_ai_usage_search" model="ir.ui.view">
        <field name="name">lab.ai.usage.search</field>
        <field name="model">lab.ai.usage</field>
        <field name="arch" type="xml">
            <search>
                <field name="project_id"/>
                <field name="employee_id"/>
                <field name="workspace_ref"/>
                <field name="actor_ref"/>
                <filter name="overhead" string="Senza corrispondenza"
                        domain="[('attribution', '=', 'overhead')]"/>
                <filter name="direct" string="Diretti su commessa"
                        domain="[('attribution', '=', 'direct')]"/>
                <separator/>
                <filter name="date" string="Giorno" date="date"/>
                <group expand="0" string="Raggruppa">
                    <filter name="by_project" string="Commessa" context="{'group_by': 'project_id'}"/>
                    <filter name="by_attribution" string="Attribuzione"
                            context="{'group_by': 'attribution'}"/>
                    <filter name="by_month" string="Mese" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_ai_usage_pivot" model="ir.ui.view">
        <field name="name">lab.ai.usage.pivot</field>
        <field name="model">lab.ai.usage</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="attribution" type="row"/>
                <field name="project_id" type="row"/>
                <field name="date" type="col" interval="month"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="action_ai_usage" model="ir.actions.act_window">
        <field name="name">Consumi AI</field>
        <field name="res_model">lab.ai.usage</field>
        <field name="view_mode">list,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">Nessun consumo AI</p>
            <p>I consumi a consumo (API, Claude Code) si inseriscono a mano, si importano da un
               file CSV (Preferiti → Importa record) oppure, se configurato, dal connettore
               Anthropic. Le <b>Corrispondenze</b> decidono a quale commessa o persona vanno.</p>
        </field>
    </record>

    <!-- ===== Corrispondenze ===== -->
    <record id="view_ai_mapping_list" model="ir.ui.view">
        <field name="name">lab.ai.mapping.list</field>
        <field name="model">lab.ai.mapping</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="ref_type"/>
                <field name="name"/>
                <field name="label"/>
                <field name="project_id"/>
                <field name="employee_id"/>
            </list>
        </field>
    </record>
    <record id="action_ai_mapping" model="ir.actions.act_window">
        <field name="name">Corrispondenze consumi AI</field>
        <field name="res_model">lab.ai.mapping</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">Nessuna corrispondenza</p>
            <p>Un workspace o una chiave API dedicati a una commessa: il costo va tutto lì (e sui
               contratti T&amp;M si ribalta al cliente). Un utente: il costo va alla persona e si
               ripartisce sulle sue ore del mese.</p>
        </field>
    </record>
</odoo>
