<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_lab" model="ir.ui.view">
        <field name="name">product.template.form.lab</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']//group[@name='group_general']" position="inside">
                <field name="lab_hours_per_unit" invisible="type != 'service'"/>
                <field name="lab_monthly_hours" invisible="type != 'service'"/>
                <field name="lab_create_default_tasks" invisible="type != 'service'"/>
            </xpath>
        </field>
    </record>
</odoo>
