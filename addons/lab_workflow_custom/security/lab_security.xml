<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===== Pianificazione (equivalente CE del modulo Planning) ===== -->
    <record id="module_category_lab_planning" model="ir.module.category">
        <field name="name">Pianificazione</field>
        <field name="sequence">40</field>
    </record>
    <record id="group_lab_planning_user" model="res.groups">
        <field name="name">Utente: i miei turni</field>
        <field name="category_id" ref="module_category_lab_planning"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_lab_planning_manager" model="res.groups">
        <field name="name">Responsabile: tutti i turni</field>
        <field name="category_id" ref="module_category_lab_planning"/>
        <field name="implied_ids" eval="[(4, ref('group_lab_planning_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- ===== Ruoli del Flusso Operativo (owner di processo) ===== -->
    <record id="module_category_lab_roles" model="ir.module.category">
        <field name="name">Ruoli Flusso Operativo</field>
        <field name="sequence">41</field>
    </record>
    <record id="group_lab_commerciale" model="res.groups">
        <field name="name">Commerciale</field>
        <field name="category_id" ref="module_category_lab_roles"/>
        <field name="comment">CRM e Vendite (propri documenti), fatture solo in bozza.</field>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman')),
                                         (4, ref('account.group_account_invoice'))]"/>
    </record>
    <record id="group_lab_pm" model="res.groups">
        <field name="name">Project Manager</field>
        <field name="category_id" ref="module_category_lab_roles"/>
        <field name="comment">Progetti, Pianificazione, Fogli ore e Report completi.</field>
        <field name="implied_ids" eval="[(4, ref('project.group_project_manager')),
                                         (4, ref('hr_timesheet.group_timesheet_manager')),
                                         (4, ref('group_lab_planning_manager')),
                                         (4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
    </record>
    <record id="group_lab_team" model="res.groups">
        <field name="name">Analista Funzionale / Sviluppatore</field>
        <field name="category_id" ref="module_category_lab_roles"/>
        <field name="comment">Task assegnati, i miei turni, i miei fogli ore.</field>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user')),
                                         (4, ref('hr_timesheet.group_hr_timesheet_user')),
                                         (4, ref('group_lab_planning_user'))]"/>
    </record>
    <record id="group_lab_support" model="res.groups">
        <field name="name">Supporto (AMS)</field>
        <field name="category_id" ref="module_category_lab_roles"/>
        <field name="comment">Come il team (task, turni, fogli ore) e in più segue in automatico
            tutte le commesse a canone di assistenza (AMS), dove arrivano le richieste.</field>
        <field name="implied_ids" eval="[(4, ref('group_lab_team'))]"/>
    </record>
    <record id="group_lab_amministrazione" model="res.groups">
        <field name="name">Amministrazione</field>
        <field name="category_id" ref="module_category_lab_roles"/>
        <field name="comment">Fatturazione completa e Vendite. Schede dipendenti (Dipendenti /
            Funzionario) per gestire tipo di risorsa, tariffe e fornitori dei consulenti esterni.</field>
        <field name="implied_ids" eval="[(4, ref('account.group_account_manager')),
                                         (4, ref('sales_team.group_sale_manager')),
                                         (4, ref('hr.group_hr_user'))]"/>
    </record>

    <!-- ===== Regole sui turni ===== -->
    <record id="rule_planning_slot_own" model="ir.rule">
        <field name="name">Turni: solo i miei</field>
        <field name="model_id" ref="model_lab_planning_slot"/>
        <field name="domain_force">[('user_id', '=', user.id), ('state', '!=', 'draft')]</field>
        <field name="groups" eval="[(4, ref('group_lab_planning_user'))]"/>
    </record>
    <record id="rule_planning_slot_all" model="ir.rule">
        <field name="name">Turni: tutti</field>
        <field name="model_id" ref="model_lab_planning_slot"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_lab_planning_manager'))]"/>
    </record>
    <record id="rule_planning_slot_company" model="ir.rule">
        <field name="name">Turni: multi-azienda</field>
        <field name="model_id" ref="model_lab_planning_slot"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
