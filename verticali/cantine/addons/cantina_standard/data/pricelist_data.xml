<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- I quattro listini standard della cantina. I prezzi dei singoli vini arrivano da vini.csv. -->
    <record id="pl_italia" model="product.pricelist">
        <field name="name">Italia – Enoteche e ingrosso</field>
        <field name="sequence">10</field>
    </record>
    <record id="pl_horeca" model="product.pricelist">
        <field name="name">Ho.Re.Ca. Italia</field>
        <field name="sequence">20</field>
    </record>
    <record id="pl_export_eu" model="product.pricelist">
        <field name="name">Export Europa (EUR)</field>
        <field name="sequence">30</field>
        <field name="currency_id" ref="base.EUR"/>
    </record>
    <record id="pl_export_usa" model="product.pricelist">
        <field name="name">Export USA (USD)</field>
        <field name="sequence">40</field>
        <field name="currency_id" ref="base.USD"/>
    </record>
</odoo>
